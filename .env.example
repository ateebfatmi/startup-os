NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Do not prefix with NEXT_PUBLIC or expose it in client code.
SUPABASE_SERVICE_ROLE_KEY=
# Set this to the canonical HTTPS origin in production (no trailing path).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
# Optional server-only endpoint for short-lived TURN credentials. It may return an ICE array or {"iceServers": [...]}.
TURN_CREDENTIALS_URL=
TURN_CREDENTIALS_TOKEN=
# Server-only Stripe billing settings.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
# OAuth integration vault. Generate a 32-byte base64 key and a separate high-entropy state secret.
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_STATE_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# Optional server-only AI provider. Without a key, Copilot uses its transparent professional local fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Production example with TURN:
# NEXT_PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.example.com:3478"},{"urls":"turn:turn.example.com:3478","username":"short-lived-user","credential":"short-lived-credential"}]
